# The temporal trajectory loss (#38), included by the training configs of the 2x2 cells with the temporal loss on (and their smoke
# tests). Not a training config on its own.
#
# Per clip: the mean over texels and frame triples of |x[t+1] - 2 x[t] + x[t-1]|^2 for each texel's final position x in mm
# (TEMPEH part + offset, so the offsets can learn to cancel TEMPEH's jitter), plus temporal_loss_rgb_weight times the same for its
# colour. Added to the clip's loss (MATCH's losses summed over its frames) at temporal_loss_weight, once per clip.

Options:
  temporal_loss_weight = 1e-3
  temporal_loss_rgb_weight = 1.0
