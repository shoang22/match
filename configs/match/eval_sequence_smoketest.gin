# PYTHONPATH=$(pwd) PYOPENGL_PLATFORM=egl conda run -n match --no-capture-output torchrun --standalone --nnodes=1 --nproc-per-node=1 scripts/match/eval_sequence.py --gin_configs configs/match/eval_sequence_smoketest.gin
# Smoke test of the sequence evaluation: the first 3 frames of SEN_a_good_morrow_to_you_my_boy and one held-out camera (402040, the one closest to frontal).
# Same model, inputs and data as the full config; only the frame count, held-out cameras, orbit length and output folder change. A few minutes on one 24 GB GPU.
# Check the outputs afterwards: conda run -n match python -m pytest tests/test_eval_sequence_smoketest.py tests/test_eval_sequence_temporal_smoketest.py tests/test_eval_sequence_preview_smoketest.py

include 'configs/match/eval_sequence_SEN_a_good_morrow.gin'
NAME = 'eval_sequence-smoketest'
OUT_DIR = 'experiments/match/eval_sequence/smoketest'
NFRAMES = 3
HELDOUT_CAMERA_IDS = ['402040']
HELDOUT_CAMERA_ANGLES = [[7.7, 24.0]]
ORBIT_FRAMES = 24  # a short orbit: the whole sweep within the 1.2 s video
