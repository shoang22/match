# Per-frame MATCH trained on clips (#38), included on top of a temporal MATCH training config (and its smoke test) to drop the
# temporal attention. Not a training config on its own.
#
# Without temporal sublayers there is nothing new to train, so every weight of the pretrained model trains (Sapiens stays frozen).
# The clips, losses, data and step budget are the temporal config's. The learning rate is lower: these are the pretrained weights,
# and the pretrained run ended at ~1.9e-6 (cosine schedule at step 860k of 1M from 4e-5). 4e-6 is the spatial learning rate of the
# temporal config's unfreezing ablation.

Options:
  temporal = False
  fine_tune = True  # start at step 0 from the pretrained weights, not from the pretrained run's optimizer and step
  temporal_spatial_lr = None
  optimizer = {
    'name': 'adamw',
    'lr': 4e-6,
    'betas': [0.9, 0.95],
    'weight_decay': 0.05,
  }
