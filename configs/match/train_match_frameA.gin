# Single-frame training on the quickstart data (one TCE049 frame), fit and evaluated on that same frame.
# Two cameras are held out of training and only appear in the validation loader, to measure novel-view quality.
# PYOPENGL_PLATFORM=egl PYTHONPATH=$(pwd) PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True torchrun --standalone --nnodes=1 --nproc-per-node=1 scripts/match/train_match.py --gin_configs configs/match/train_match_frameA.gin
NAME = "match_frameA"
BASE_FOLDER = "experiments/clean"

AVA_HEIGHT = 786
AVA_WIDTH = 512
AVA_HEAD_CROP = True
AVA_HEAD_CROP_HEIGHT = 640
AVA_HEAD_CROP_WIDTH = 512
HEAD_CROP_OFFSET_Y = -64
INPUT_RES = %AVA_HEAD_CROP_HEIGHT
OUTPUT_RES = %INPUT_RES
AVA_ROOT = 'data/ava-256'
AVA_FRAME_STRIDE = 10
AVA_UV_DIR = 'data/tempeh_predictions/ava-256/quickstart/ava-256'
AVA_COARSE_MESH_DIR = %AVA_UV_DIR
# Held out: [0, -15] (cam 401919) and [20, 36] (cam 402012). Dropping them leaves every other angle on the same camera.
AVA_TRAIN_CAMERA_ANGLES = [[0,0],
                  [20,0], [20, -15],
                  [-20,0], [-20, 36], [-20, -15],
                  [40,-5], [40, 25],
                  [-40,-5], [-40, 25],
                  ]
# Loaded views keep this order. Eval renders views linspace(0, 11, 8) = [0, 1, 3, 4, 6, 7, 9, 11],
# so the held-out angles sit at 9 and 11 to be rendered; val_input_idcs only picks training cameras.
AVA_VAL_CAMERA_ANGLES = [[0,0],
                  [20,0], [20, -15],
                  [-20,0], [-20, 36], [-20, -15],
                  [40,-5], [40, 25],
                  [-40,-5],
                  [0, -15],  # held out
                  [-40, 25],
                  [20, 36],  # held out
                  ]
BATCH_SIZE = 1

# calculating derrived values
base_folder/join_strings.strings = [%BASE_FOLDER, '/', %NAME]

Options:
    # Experiment
    base_folder = @base_folder/join_strings()
    n_vissamples = 1
    max_val_steps = 1
    initial_eval = True
    # Same proportions as train_match.gin (geometry-only for the first 10%, LPIPS ramped in at 15-20%).
    # Measured ~2.0 s/step on a 4090 with 8 input views (plus evals), so 20k steps takes ~11-12 h.
    geom_only_steps = 2_000
    lpips_warmup_start = 3_000
    lpips_warmup_end = 4_000
    max_train_steps = 20_000
    eval_freq = 1_000
    early_eval_freq = 1_000
    log_freq = 10
    save_freq = 2_000
    restart_after_eval_frequency = None

    # Model
    use_sapiens_features = True
    sapiens_prediction_tiles_sqrt = 2
    skip_connection = True
    num_blocks = 6
    n_neighbors = 100
    uv_res = 512
    uv_patch_size = 16  # 32x32 uv patches; the correspondence step scales with views x uv patches x pixels
    input_res = %INPUT_RES
    output_res = %OUTPUT_RES
    template_mesh_vertex_groups_path = 'assets/ava256/vertex_groups_with_neck_and_scalp.json'

    # DATASET
    # TCE049 is a validation subject, so training=None disables the train/val split.
    # nsamples=1 pins the dataset to frame 0 (32885), the only frame with TEMPEH predictions.
    # No sapiens segmentations or kinematic tracking were downloaded, so both are optional here.
    train_loader_params = {
        'cls': 'ava256',
        'kwargs': {
        'dataloader_kwargs': {
            'batch_size': %BATCH_SIZE,
            'num_workers': 2,
            # The dataset has one sample, so every step is a new epoch; without this the workers respawn each step.
            # More workers don't help: only one sample is loaded per epoch (8 workers measured slower than 2).
            'persistent_workers': True,
        },
        'dataset_kwargs': {
            "root_path": %AVA_ROOT,
            'height': %AVA_HEIGHT,
            'width': %AVA_WIDTH,
            "camera_angles":  %AVA_TRAIN_CAMERA_ANGLES,
            'uv_directory': %AVA_UV_DIR,
            'coarse_mesh_directory': %AVA_COARSE_MESH_DIR,
            'frame_stride': %AVA_FRAME_STRIDE,
            'head_crop': %AVA_HEAD_CROP,
            'head_crop_height': %AVA_HEAD_CROP_HEIGHT,
            'head_crop_width': %AVA_HEAD_CROP_WIDTH,
            'head_crop_offset_y': %HEAD_CROP_OFFSET_Y,
            'training': None,
            'nsamples': 1,
            'require_segmentation': False,
            'require_verts': False,
        }
        }
    }
    val_loader_params = [
        {
        'name': 'ava_val',
        'cls': 'ava256',
        'kwargs': {
            'dataloader_kwargs': {
            "batch_size": %BATCH_SIZE,
            'num_workers': 1,
            },
            'dataset_kwargs': {
            "root_path": %AVA_ROOT,
            'height': %AVA_HEIGHT,
            'width': %AVA_WIDTH,
            "camera_angles":  %AVA_VAL_CAMERA_ANGLES,
            'uv_directory': %AVA_UV_DIR,
            'coarse_mesh_directory': %AVA_COARSE_MESH_DIR,
            'frame_stride': %AVA_FRAME_STRIDE,
            'head_crop': %AVA_HEAD_CROP,
            'head_crop_height': %AVA_HEAD_CROP_HEIGHT,
            'head_crop_width': %AVA_HEAD_CROP_WIDTH,
            'head_crop_offset_y': %HEAD_CROP_OFFSET_Y,
            'training': None,
            'nsamples': 1,
            'require_segmentation': False,
            'require_verts': False,
            }
        }
        },
    ]
    segmentation_labels_path = 'assets/sapiens/segmentation_labels.json'

    # Training
    optimizer = {
            "name": "adamw",
            "lr": 4e-5,
            "betas": [0.9, 0.95],
            "weight_decay": 0.05,
    }
    grad_checkpoint = True
    find_unused_parameters = True
    num_input_views = 8  # must be a multiple of 4 (Sapiens tiles views 2x2); 8 peaks at ~18 GB on a 4090
    val_input_idcs = [0, 1, 3, 4, 6, 7, 8, 10]  # training cameras only; skips [20,-15], [-20,-15] and the held-out 9, 11
    num_views = 8
    num_render_views = 8
    input_bg = 'white'
    output_bg = 'random'

    # Losses
    lpips_weight = 1.0
    render_weight = 0.0
    l1_weight = 0.8
    ssim_weight = 0.2
    mesh_vert_weight = 0.0  # no kinematic tracking downloaded -> GT verts are zeros
    xyz_weight = 1e-3
    scale_weight = 1e-3
    scale_target = 0.0005
    noloss_masks = []  # no sapiens segmentations
