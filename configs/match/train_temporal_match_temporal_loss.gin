# Temporal MATCH with the temporal trajectory loss (#38), the 2x2 cell "temporal attention on, temporal loss on" (#42).
# PYOPENGL_PLATFORM=egl PYTHONPATH=$(pwd) PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True torchrun --standalone --nnodes=1 --nproc-per-node=1 scripts/match/train_match.py --gin_configs configs/match/train_temporal_match_temporal_loss.gin
#
# configs/match/train_temporal_match.gin (stage 1) plus the loss on each texel's trajectory over the clip
# (configs/match/temporal_loss.gin). Same data needs as the stage-1 config; only the temporal loss and the output folder (NAME)
# differ. The smoke test on data that is on disk: configs/match/train_temporal_match_temporal_loss_smoketest.gin.

include 'configs/match/train_temporal_match.gin'
include 'configs/match/temporal_loss.gin'
NAME = 'temporal_match_temporal_loss'
